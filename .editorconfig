# Unified coding style for different editors
# More information at https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
spelling_language = en-us
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[.git/**]
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false
indent_style = space
indent_size = 4

[*.{sh,zsh,bash,ksh}]
indent_style = space
indent_size = 4
