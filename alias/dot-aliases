# Easier navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."

# System tool defaults
alias grep="grep --color=auto"
alias diff="diff --color=auto"
alias ls="ls --color=auto -hF"
alias ll="ls -l"
alias la="ls -la"
alias l.="ls -d .*"

# Alias one command to another
alias vim="nvim"
alias trash="gio trash" # Gnome built-in. Alternatives: trash-cli

# Custom
alias dotfiles="cd $DOTFILES && $VISUAL -c 'Explore'"
alias ledger_file="$VISUAL + $TRUENAS_HOME/financeiro/ledger/otavio.ledger"
alias notes="cd $TRUENAS_HOME/obsidian && $VISUAL -c 'Explore'"
alias notebook="notes"
