# Base shell-independent configuration
source $HOME/.profile

# Load ble.sh. Replace GNU readline (default) as line editor
# Also, required by starship prompt
[[ $- == *i* ]] && source -- ~/.local/share/blesh/ble.sh --attach=none

# Shell options
shopt -s cdspell
shopt -s checkwinsize
shopt -s extglob

# Enable if supported. Bash version >= 4
shopt -s autocd 2>/dev/null || true
shopt -s dirspell 2>/dev/null || true

# History
shopt -s histappend
export HISTCONTROL="ignoredups:erasedups:ignorespace"
export HISTSIZE=11000
export HISTFILESIZE=10000
export HISTFILE="$HOME/.bash_history"

# User aliases
source $HOME/.aliases

# Prompt line - https://github.com/starship/starship
[[ ! ${BLE_VERSION-} ]] || ble-attach && eval "$(starship init bash)"

# Completions
complete -A binding bind
complete -A setopt set
complete -A shopt shopt
complete -A helptopic help
complete -a alias unalias
complete -b builtin
complete -c type which
complete -cf man sudo
complete -d cd pushd rmdir
